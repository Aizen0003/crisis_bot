# Crisis Intelligence Command Center — environment template
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
#
# NOTE: `.env` is gitignored. Never commit real keys.

# Google AI Studio API key (https://aistudio.google.com/)
GEMINI_API_KEY=

# Qdrant Cloud cluster URL, e.g. https://your-cluster.cloud.qdrant.io:6333
QDRANT_URL=

# Qdrant Cloud API key
QDRANT_API_KEY=
